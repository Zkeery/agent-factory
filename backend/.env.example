# Agent造物坊 后端配置示例（复制为 .env 使用，不提交真实值）
DATABASE_URL=sqlite:///./data/factory.db
PORT=8010
# LLM：mock=离线占位（零成本）；deepseek=真实模型（需填 Key）
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 单次模型调用超时秒数（走代理或生成慢时调大）
LLM_TIMEOUT=120
# 成本估算单价（元/百万 token，DeepSeek 约价，非账单）
COST_PER_1M_INPUT=1.0
COST_PER_1M_OUTPUT=2.0
# 运行看门狗：run 卡死阈值（秒）与扫描间隔（秒）
RUN_STUCK_TIMEOUT=300
WATCHDOG_INTERVAL=30
